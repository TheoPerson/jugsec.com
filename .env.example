# Database (PostgreSQL — Neon, Supabase, or local)
DATABASE_URL="postgres://user:password@host:5432/frameforge"

# Auth
SESSION_SECRET="generate-a-64-char-random-string"

# Google Gemini AI (optional — enables AI-powered analysis)
GEMINI_API_KEY="your_gemini_api_key"

# Server
PORT=5173
NODE_ENV=development
